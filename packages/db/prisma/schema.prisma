// schema.prisma — AutoEOD Phase 1
// Source of truth per PRD §5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("USER") // "USER" | "ADMIN"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settings          UserSettings?
  githubIntegration GithubIntegration?
  activityEvents    ActivityEvent[]
  reports           Report[]
  notifications     Notification[]
  extensionTokens   ExtensionToken[]
  emailConnection   EmailConnection?
  browserLogs       BrowserActivityLog[]
  extensionSettings UserExtensionSettings?
  holidays          Holiday[]
  reportSkipLogs    ReportSkipLog[]
  timelineSettings  TimelineSettings?
  timelineSessions  TimelineSession[]
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  timezone       String  @default("Asia/Kolkata") // IANA tz name
  workStartTime  String  @default("09:00") // 24h "HH:mm", local to timezone
  workEndTime    String  @default("18:00")
  reportTime     String  @default("17:50") // when daily report generation fires
  autoGenerate   Boolean @default(true)
  autoSend       Boolean @default(false)
  managerEmail   String?
  ccEmails       String? // comma-separated
  reportTemplate String  @default("professional") // "professional" | "short" | "detailed"
  reportLanguage String  @default("english") // "english" | "hindi" | "gujarati"
  chatgptCaptureContent Boolean @default(false)
  includeRadarLogs Boolean @default(false)
  includeTimeBlocks Boolean @default(false)
  workingDays      Int[]   @default([1, 2, 3, 4, 5]) // 1=Mon, 7=Sun

  updatedAt DateTime @updatedAt
}

model EmailConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  provider        String    // "google" | "zoho"
  email           String
  name            String?
  avatar          String?
  
  accessTokenEnc  String
  refreshTokenEnc String
  expiresAt       DateTime
  
  connectedAt     DateTime  @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
}

model GithubIntegration {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubUserId   String
  githubUsername String
  accessTokenEnc String // AES-256-GCM encrypted
  scopes         String // space-separated scopes granted
  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?
  lastSyncCursor String? // ISO timestamp of last successfully fetched event
  needsReconnect Boolean   @default(false)

  @@index([userId])
}

// Normalized record of one unit of GitHub activity.
// source-tagged so Phase 2 (Jira, etc.) adds rows without schema change.
model ActivityEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  source     String // "github" (only in Phase 1)
  type       String // "commit" | "pull_request" | "pr_review" | "issue" | "issue_comment"
  externalId String // GitHub's id/sha for de-duplication
  repo       String // e.g. "karan/noctune"
  title      String // commit message / PR title / issue title
  url        String // link back to GitHub
  occurredAt DateTime // when the event actually happened on GitHub
  rawPayload Json // full API response for audit/debug/reprocessing

  createdAt DateTime @default(now())

  @@unique([userId, source, externalId])
  @@index([userId, occurredAt])
}

model Report {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reportDate String // "YYYY-MM-DD", local to user's timezone
  status     String @default("draft") // "draft" | "approved" | "sent" | "failed"

  summary         String? @db.Text
  completedItems  Json? // string[]
  inProgressItems Json? // string[]
  blockers        String? @db.Text
  tomorrowPlan    String? @db.Text
  timeBlocks      Json? // Array of collaborated time-blocks { startTime, endTime, title, category, details, toolsAndWebsites }

  rawEventIds  Json // string[] of ActivityEvent.id used to generate this report
  aiModel      String? // model name used, for audit
  generatedAt  DateTime?
  sentAt       DateTime?
  sentTo       String?
  errorMessage String? // populated if status = "failed"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reportDate])
  @@index([userId, reportDate])
}

// In-app notifications (Phase 1 minimum: unread flag per report)
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String // "report_ready" | "report_failed" | "github_disconnected"
  title     String
  message   String
  reportId  String? // link to report if applicable
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Extension auth tokens
model ExtensionToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash   String   @unique
  label       String   @default("Browser Extension")
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([userId])
}

model BrowserActivityLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  domain          String
  url             String   @db.Text
  pageTitle       String
  tabOpenedAt     DateTime
  tabClosedAt     DateTime?
  durationSeconds Int      @default(0)

  captureTier     Int      // 0, 1, or 2
  snapshotText    String?  @db.Text   // populated only if captureTier >= 1
  adapterPayload  Json?                // populated only if captureTier = 2

  selected        Boolean  @default(false)
  promotedToEventId String? @unique

  createdAt       DateTime @default(now())

  @@index([userId, tabOpenedAt])
  @@index([userId, domain])
}

model UserExtensionSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  globalPaused        Boolean  @default(false)
  tier1GlobalDefault  Boolean  @default(false)
  tier1DomainAllowlist Json    @default("[]")
  excludedDomains     Json    @default("[]")

  updatedAt           DateTime @updatedAt
}

model TimelineSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled             Boolean  @default(false)
  trackingIntervalMin Int      @default(5)

  updatedAt           DateTime @updatedAt
}

model Holiday {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date   String // "YYYY-MM-DD"
  name   String

  @@index([userId, date])
}

model ReportSkipLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date   String // "YYYY-MM-DD"
  reason String

  createdAt DateTime @default(now())

  @@index([userId, date])
}

model TimelineSession {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  startTime         DateTime
  endTime           DateTime
  durationSeconds   Int

  appName           String
  windowTitle       String?
  project           String?
  detectedTask      String?
  aiSummary         String?

  selected          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, startTime])
}

model SystemConfig {
  id                  String   @id @default("global")
  apiBaseUrl          String   @default("https://autoeod.onrender.com")
  webBaseUrl          String   @default("https://autoeod.onrender.com")
  maintenanceMode     Boolean  @default(false)
  forceUpdate         Boolean  @default(false)
  minExtensionVersion String   @default("1.0.0")
  minDesktopVersion   String   @default("1.0.0")
  updatedAt           DateTime @updatedAt
}

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  subject     String
  bodyHtml    String
  bodyText    String?
  enabled     Boolean  @default(true)
  variables   String   @default("[]") // JSON string of available variables
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  level       String   @default("info")
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ── Enterprise Observability & Audit Models ───────────────────────────────────

model AuditEvent {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  actorId      String?
  actorEmail   String?
  actorRole    String?
  targetUserId String?
  action       String   // e.g. "AUTH.LOGIN_SUCCESS", "REPORT.GENERATED", "SETTINGS.UPDATED"
  category     String   @default("user") // "auth" | "user" | "report" | "integration" | "ai" | "email" | "system"
  resource     String?  // "user" | "report" | "integration" | "settings" | "config"
  resourceId   String?
  status       String   @default("SUCCESS") // "SUCCESS" | "FAILURE" | "DENIED"
  reason       String?
  details      Json?    // Structured redacted metadata
  beforeState  Json?
  afterState   Json?
  ipAddress    String?
  userAgent    String?
  requestId    String?
  traceId      String?
  spanId       String?

  @@index([timestamp])
  @@index([actorId, timestamp])
  @@index([targetUserId, timestamp])
  @@index([action, timestamp])
  @@index([category, timestamp])
  @@index([traceId])
}

model AdminAction {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  adminId     String
  adminEmail  String
  action      String   // e.g. "CONFIG.UPDATED", "USER.ROLE_CHANGED", "EXTENSION.RELEASE_BUILT"
  targetType  String?  // "user" | "config" | "template" | "alert" | "retention" | "system"
  targetId    String?
  before      Json?
  after       Json?
  reason      String?
  details     Json?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  traceId     String?

  @@index([timestamp])
  @@index([adminId, timestamp])
  @@index([action, timestamp])
}

model SecurityEvent {
  id          String    @id @default(cuid())
  timestamp   DateTime  @default(now())
  eventType   String    // "AUTH.LOGIN_FAILED", "SECURITY.BRUTE_FORCE_SUSPECTED", "SECURITY.PERMISSION_DENIED", etc.
  severity    String    @default("LOW") // "LOW" | "MEDIUM" | "HIGH" | "CRITICAL"
  userId      String?
  userEmail   String?
  ipAddress   String?
  userAgent   String?
  route       String?
  method      String?
  statusCode  Int?
  requestId   String?
  traceId     String?
  details     Json?
  resolved    Boolean   @default(false)
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([timestamp])
  @@index([severity, timestamp])
  @@index([eventType, timestamp])
  @@index([ipAddress, timestamp])
  @@index([userId, timestamp])
}

model ErrorGroup {
  id                 String            @id @default(cuid())
  fingerprint        String            @unique
  name               String
  message            String
  service            String            @default("api")
  environment        String            @default("production")
  firstSeen          DateTime          @default(now())
  lastSeen           DateTime          @default(now())
  totalOccurrences   Int               @default(1)
  affectedUsersCount Int               @default(1)
  status             String            @default("UNRESOLVED") // "UNRESOLVED" | "RESOLVED" | "IGNORED"
  lastTraceId        String?
  sampleStackTrace   String?           @db.Text
  occurrences        ErrorOccurrence[]

  @@index([status, lastSeen])
  @@index([firstSeen])
}

model ErrorOccurrence {
  id          String     @id @default(cuid())
  groupId     String
  group       ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  timestamp   DateTime   @default(now())
  message     String
  stackTrace  String?    @db.Text
  userId      String?
  userEmail   String?
  route       String?
  method      String?
  statusCode  Int?
  requestId   String?
  traceId     String?
  metadata    Json?

  @@index([groupId, timestamp])
  @@index([timestamp])
  @@index([traceId])
}

model AlertRule {
  id                  String          @id @default(cuid())
  name                String
  description         String?
  metric              String          // "5xx_rate" | "ai_fallback_rate" | "job_failure_rate" | "db_latency" | "security_failures"
  condition           String          @default("gt") // "gt" | "lt" | "eq"
  threshold           Float
  windowMinutes       Int             @default(5)
  severity            String          @default("WARNING") // "INFO" | "WARNING" | "CRITICAL"
  enabled             Boolean         @default(true)
  notificationChannel String          @default("email")
  recipients          String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  incidents           AlertIncident[]
}

model AlertIncident {
  id          String    @id @default(cuid())
  ruleId      String
  rule        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  status      String    @default("TRIGGERED") // "TRIGGERED" | "RESOLVED" | "ACKNOWLEDGED"
  triggeredAt DateTime  @default(now())
  resolvedAt  DateTime?
  metricValue Float
  message     String
  details     Json?

  @@index([ruleId, triggeredAt])
  @@index([status, triggeredAt])
}

model RetentionPolicy {
  id                 String   @id @default(cuid())
  logCategory        String   @unique // "app_logs" | "api_logs" | "error_logs" | "audit_logs" | "security_logs" | "job_logs"
  retentionDays      Int      @default(30)
  archiveEnabled     Boolean  @default(false)
  archiveStoragePath String?
  updatedAt          DateTime @updatedAt
}

model LogExportJob {
  id                  String    @id @default(cuid())
  requestedByUserId   String
  requestedByUserEmail String
  category            String
  filters             Json?
  format              String    @default("json") // "json" | "csv"
  status              String    @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  rowCount            Int?
  fileSizeBytes       Int?
  downloadUrl         String?
  errorMessage        String?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([requestedByUserId, createdAt])
}

model ObservabilitySettings {
  id                  String   @id @default("global")
  logLevel            String   @default("info") // "trace" | "debug" | "info" | "warn" | "error"
  samplingRatePercent Float    @default(100.0)
  aiPromptPrivacy     String   @default("metadata_only") // "off" | "metadata_only" | "full"
  redactionEnabled    Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

