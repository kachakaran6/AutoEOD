# ============================================================
# AutoEOD — Production & Local Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit the .env file to version control.
# ============================================================

# --- Database [API + Worker] ---
# Local: postgresql://autoeod:autoeod@localhost:5432/autoeod
# Production (Neon): postgresql://neondb_owner:PASSWORD@ep-xxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://autoeod:autoeod@localhost:5432/autoeod

# --- Redis [API + Worker] ---
# Local: redis://localhost:6379
# Production (Upstash): rediss://default:PASSWORD@endpoint.upstash.io:6379
REDIS_URL=redis://localhost:6379

# --- JWT Secrets [API] ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-here-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-here-min-32-chars

# --- Encryption Key [API + Worker] ---
# AES-256-GCM key for encrypting OAuth tokens at rest
# Must be exactly 64 hex characters (32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# --- GitHub OAuth [API + Worker] ---
# Set callback URL:
# Local: http://localhost:3001/api/integrations/github/callback
# Production: https://your-render-api-domain.onrender.com/api/integrations/github/callback
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/integrations/github/callback

# --- AI Integration [API + Worker] ---
# OpenAI API key or compatible provider key (Groq, etc.)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- Email System [Worker] ---
# Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=re_your-resend-api-key-here
EMAIL_FROM=AutoEOD <reports@yourdomain.com>

# --- Email OAuth Providers [API + Worker] ---
# Google OAuth: https://console.cloud.google.com/apis/credentials
# Local Callback: http://localhost:3001/api/auth/google/callback
# Production Callback: https://your-render-api-domain.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Zoho OAuth: https://api-console.zoho.com
# Local Callback: http://localhost:3001/api/auth/zoho/callback
# Production Callback: https://your-render-api-domain.onrender.com/api/auth/zoho/callback
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_CALLBACK_URL=http://localhost:3001/api/auth/zoho/callback
ZOHO_OAUTH_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://mail.zoho.com

# --- Cors & Application URLs [API + Worker] ---
# Local: http://localhost:5173
# Production: https://your-vercel-domain.vercel.app
FRONTEND_URL=http://localhost:5173

# --- Frontend API Config [Vercel Frontend] ---
# Production API URL for Vercel deployment: https://your-render-api-domain.onrender.com
VITE_API_URL=http://localhost:3001
# Google Analytics 4 Measurement ID (gtag.js)
VITE_GA_MEASUREMENT_ID=G-S703P0SKBF

# --- Server & Logging Settings [API + Worker] ---
PORT=3001
NODE_ENV=production
LOG_LEVEL=info
