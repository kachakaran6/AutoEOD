FROM node:20-slim

WORKDIR /app

# Install curl for healthchecks and OpenSSL for Prisma client
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Optimize memory limit during compilation on low-RAM VPS
ENV NODE_OPTIONS="--max-old-space-size=1536"

# Copy package manifests for workspace dependency resolution
COPY package.json package-lock.json ./
COPY packages/db/package.json ./packages/db/
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
COPY apps/desktop/package.json ./apps/desktop/
COPY apps/extension/package.json ./apps/extension/

# Install dependencies cleanly with offline preference
RUN npm ci --prefer-offline --no-audit --no-fund

# Copy full repository source code
COPY . .

# Generate Prisma client and compile backend TypeScript projects (packages/db, apps/api, apps/worker)
RUN npm run build:backend

# Set production environment variables
ENV NODE_ENV=production
ENV PORT=3001

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3001/health || exit 1

# Default command starts both API service and Background Worker with auto DB migration push
CMD ["npm", "start"]
